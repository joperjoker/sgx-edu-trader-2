# Google Cloud & Firebase Client Configuration (Public)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Firebase Admin SDK (Server-Only JSON or Individual Credentials)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Google AI Studio / Vertex AI Gemini 2.5 Flash Key
GEMINI_API_KEY=your_gemini_api_key

# Google Cloud Scheduler Secret Token
CRON_SECRET=your_64_char_random_hex_secret

# Pre-Authorized Superadmin & Teacher Gmail Accounts (comma-separated)
SUPERADMIN_EMAILS=admin@sgxedu.sg
TEACHER_EMAILS=teacher@sgxedu.sg

# Optional Market Data Fallback
STOCK_DATA_PROVIDER=yahoo
TWELVE_DATA_API_KEY=

# School & App Metadata
NEXT_PUBLIC_APP_NAME="SGX Edu-Trader 2.0"
NEXT_PUBLIC_SCHOOL_NAME="Singapore Academy of Finance"
